<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/colorSurface">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="?attr/colorSurface"
        app:liftOnScroll="true" app:liftOnScrollTargetViewId="@id/content_scroll">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name" app:menu="@menu/main" />
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/content_scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:fillViewport="true" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:id="@+id/content_panel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/connection_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh" app:cardElevation="0dp"
                app:strokeWidth="0dp" app:shapeAppearanceOverlay="@style/Shape.Bridge.Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="24dp">
                    <ImageView android:id="@+id/connection_icon" android:layout_width="36dp" android:layout_height="36dp"
                        android:importantForAccessibility="no" android:src="@drawable/ic_folder" app:tint="?attr/colorPrimary" />
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="20dp"
                        android:text="@string/connection_title" android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/connection_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/disconnected"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium" android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/connection_summary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="@string/disconnected_summary"
                        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.google.android.material.chip.Chip android:id="@+id/access_mode"
                        style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:text="@string/read_write" android:clickable="false" android:focusable="false"
                        app:chipIcon="@drawable/ic_edit" app:chipIconTint="?attr/colorOnSurfaceVariant" app:chipIconVisible="true" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/connecting_progress"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone" />
                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/connection_switch"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="64dp" android:layout_marginTop="4dp" android:text="@string/connect_folder"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:drawablePadding="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/error_card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:visibility="gone" app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorErrorContainer" app:shapeAppearanceOverlay="@style/Shape.Bridge.Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/error_details"
                        android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnErrorContainer" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/error_details"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textIsSelectable="true"
                        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnErrorContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="4dp" android:text="@string/destinations"
                android:textAppearance="@style/TextAppearance.Bridge.Section" android:accessibilityHeading="true" />
            <include android:id="@+id/main_destination" layout="@layout/view_destination" />
            <include android:id="@+id/work_destination" layout="@layout/view_destination"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="4dp" android:text="@string/connection_options"
                android:textAppearance="@style/TextAppearance.Bridge.Section" android:accessibilityHeading="true" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardElevation="0dp" app:strokeWidth="0dp" app:shapeAppearanceOverlay="@style/Shape.Bridge.Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/read_only_switch"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                        android:text="@string/read_only" android:textAppearance="?attr/textAppearanceTitleMedium" android:drawablePadding="16dp" />
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/read_only_description"
                        android:layout_marginBottom="20dp" android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/work_profile_switch"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
                        android:layout_marginTop="8dp" android:text="@string/work_enabled"
                        android:textAppearance="?attr/textAppearanceTitleMedium" android:drawablePadding="16dp" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/work_profile_description" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/work_description"
                        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/auto_boot_switch"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
                        android:layout_marginTop="8dp" android:text="@string/auto_boot" android:textAppearance="?attr/textAppearanceTitleMedium" />
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/auto_boot_description"
                        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textview.MaterialTextView android:id="@+id/options_locked_hint"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:layout_marginHorizontal="4dp" android:text="@string/options_locked" android:visibility="gone"
                android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.button.MaterialButton android:id="@+id/check_access"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="20dp"
                android:text="@string/check_access" app:icon="@drawable/ic_shield" app:iconGravity="textStart" />
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginHorizontal="4dp"
                android:text="@string/behavior_title" android:textAppearance="?attr/textAppearanceTitleSmall" android:accessibilityHeading="true" />
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginHorizontal="4dp"
                android:text="@string/behavior_description" android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginHorizontal="4dp"
                android:text="@string/scope_description" android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/version_footer"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" android:gravity="center" android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
